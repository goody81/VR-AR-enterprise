{
  "name": "@18plusai/vr-ar-enterprise",
  "version": "1.0.0",
  "description": "Enterprise VR/AR platform by 18PlusAi Studios",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:e2e": "jest tests/e2e",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write \"src/**/*.{js,json,md}\"",
    "build": "webpack --mode production",
    "docs": "jsdoc -c jsdoc.json",
    "clean": "rm -rf dist coverage .jest"
  },
  "keywords": [
    "vr",
    "ar",
    "virtual-reality",
    "augmented-reality",
    "enterprise",
    "ai",
    "18+"
  ],
  "author": "18PlusAi Studios",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/goody81/VR-AR-enterprise.git"
  },
  "bugs": {
    "url": "https://github.com/goody81/VR-AR-enterprise/issues"
  },
  "homepage": "https://github.com/goody81/VR-AR-enterprise#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "express": "^4.18.2",
    "dotenv": "^16.3.1"
  }
}
